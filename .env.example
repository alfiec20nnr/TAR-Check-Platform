# ==============================================================================
# Adverse Intelligence Platform — environment configuration
# Copy to `.env` and fill in values. Values shown are development defaults.
# ==============================================================================

# --- Branding -----------------------------------------------------------------
# Display name shown in the browser tab, header, welcome dialog and footer.
# Change this to rebrand the application without touching any code.
APP_NAME=Adverse Intelligence

# --- Database -----------------------------------------------------------------
POSTGRES_USER=aip
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aip
# Used by the API/worker containers (host `db` inside docker compose):
DATABASE_URL=postgresql+asyncpg://aip:change-me@db:5432/aip

# --- Security -----------------------------------------------------------------
# Fernet key for encrypting personal data at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, data is stored unencrypted (development only — a warning is logged).
ENCRYPTION_KEY=

# --- Login ----------------------------------------------------------------------
# Accounts live in the users table. On first launch the UI asks for a username
# and password (creating user #1); manage accounts from backend/ with:
#   python -m app.users add|list|reset|disable|remove <username>
# AUTH_USERNAME / AUTH_PASSWORD_HASH are legacy single-user credentials — an
# install upgrading from a pre-multi-user version has them here already and
# they are migrated into the users table automatically on next start. Leave
# them empty on new installs.
# AUTH_SECRET signs session cookies and is generated automatically on start.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_SECRET=
# How long a login lasts before the user must sign in again.
AUTH_SESSION_HOURS=12

# Machine activation code, issued by the software provider for one specific
# machine. On an unactivated machine the UI shows the machine code and asks
# for this; it is written here automatically once entered.
LICENCE_KEY=

# Comma-separated list of allowed CORS origins (frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# API rate limit (requests per minute per client IP).
API_RATE_LIMIT=60/minute

# Login attempts per minute per client IP (brute-force protection).
AUTH_LOGIN_RATE_LIMIT=10/minute

# --- Hosted mode (internet-facing VPS via docker-compose.prod.yml) --------------
# See docs/DEPLOYMENT.md "Hosted on a VPS". Leave these at their defaults for
# local / LAN use.
# Public hostname — Caddy obtains a Let's Encrypt certificate for it.
#AIP_DOMAIN=aip.example.co.uk
# Session cookie only sent over HTTPS. Required on a hosted instance; must
# stay false for plain-HTTP local use.
#SESSION_COOKIE_SECURE=true
# Disable the in-browser first-launch setup screen; seed accounts with
# `python -m app.users` instead (never expose a fresh instance before doing so).
#AUTH_ALLOW_SETUP=false
# Hide the interactive API docs (/docs, /redoc, /openapi.json).
#EXPOSE_API_DOCS=false
# And remember on a hosted instance: CORS_ORIGINS=https://<AIP_DOMAIN>

# --- Pipeline -----------------------------------------------------------------
# Run the search pipeline inside the API process (dev convenience) instead of
# the dedicated worker container.
INLINE_WORKER=false

# Return realistic fixture data from every connector instead of calling
# external APIs. Lets the full pipeline run with zero API keys.
MOCK_CONNECTORS=true

# Days to retain completed searches/reports (audit log is always kept).
DATA_RETENTION_DAYS=365

# --- AI summarisation (Anthropic Claude) ---------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# --- Connector API keys ---------------------------------------------------------
# Brave Search API — recommended web-search source, open to new customers.
# Free tier: https://api-dashboard.search.brave.com/register
# Also powers the social-media connector (site-restricted queries).
BRAVE_API_KEY=

# Social media screening — platforms searched via the Brave API (public index
# only; no platform scraping). Comma-separated hostnames; add e.g. linkedin.com
# to extend. Uses BRAVE_API_KEY above.
SOCIAL_MEDIA_SITES=x.com,twitter.com,facebook.com,instagram.com,tiktok.com,reddit.com,youtube.com

# Google Programmable Search — ⚠ closed to NEW customers since Jan 2026
# (grandfathered keys only; new projects get 403). Use Brave instead.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# NewsAPI (https://newsapi.org)
NEWSAPI_KEY=

# UK Companies House (https://developer.company-information.service.gov.uk)
COMPANIES_HOUSE_API_KEY=

# FCA Financial Services Register (https://register.fca.org.uk/Developer)
FCA_API_EMAIL=
FCA_API_KEY=

# UK Sanctions List — public download, no key required. This is the live FCDO
# XML feed (the single authoritative UK list since the OFSI JSON was retired
# in January 2026). A licensed provider's JSON endpoint also works here.
UK_SANCTIONS_LIST_URL=https://sanctionslist.fcdo.gov.uk/docs/UK-Sanctions-List.xml

# UK personal insolvency — works out of the box: bankruptcy and other
# personal-insolvency notices come from The Gazette's official public data API
# (no key required, Open Government Licence). For full Individual Insolvency
# Register coverage including IVAs and Debt Relief Orders (never published in
# The Gazette), configure a licensed data provider endpoint instead:
INSOLVENCY_API_URL=
INSOLVENCY_API_KEY=

# DVLA Access to Driver Data (ADD) — requires a commercial agreement with DVLA
# (developer-portal.driver-vehicle-licensing.api.gov.uk). Credentials are
# issued by DVLA per consumer. Base URL defaults to UAT; for production set:
#   DVLA_API_BASE_URL=https://driver-vehicle-licensing.api.gov.uk
# Note: DVLA passwords expire every 90 days.
DVLA_API_BASE_URL=https://uat.driver-vehicle-licensing.api.gov.uk
DVLA_USERNAME=
DVLA_PASSWORD=
DVLA_API_KEY=
